# ==============================================================================
# Urumi MCP Gateway - Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Chat Agent (OpenRouter / OpenAI-compatible API)
# ------------------------------------------------------------------------------
# Required ONLY if you want to use the built-in Chat Agent in the web dashboard.
# Get a key from https://openrouter.ai (free models like Nemotron/Llama work well).
# During `make up` or `make deploy`, scripts/llm-secret.sh reads this key and
# creates the in-cluster Secret `llm-credentials`.
LLM_API_KEY=sk-or-v1-your-openrouter-api-key-here

# Optional: LLM model and base URL (defaults shown below)
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# LLM_BASE_URL=https://openrouter.ai/api/v1


# ------------------------------------------------------------------------------
# 2. Acceptance & E2E Testing Flags (scripts/dod-test.ts)
# ------------------------------------------------------------------------------
# Optional flags used when running `npm run dod` or `make dod`.
# APP_URL=http://app.localtest.me
# STORE_URL=http://store.localtest.me
# PLATFORM_NS=urumi-platform
# MCP_NS=urumi-mcp

# Set to 1 to skip LLM chat steps in tests (saves API credits):
# SKIP_CHAT=1

# Set to 1 to run tests against the real Claude Code CLI:
# CLAUDE_CLI=0


# ------------------------------------------------------------------------------
# 3. Standalone / Local Gateway Development (Outside Kubernetes only)
# ------------------------------------------------------------------------------
# NOTE: When running inside Kubernetes (via Helm / k3d / k3s), the cluster secrets
# and values files supply these automatically. You only need these if running the
# Gateway Node.js process directly on your host machine.
#
# DATABASE_URL=postgres://gateway:postgres@localhost:5432/gateway
# MASTER_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE= # Exactly 32 bytes base64
# PUBLIC_URL=http://localhost:8080
# PORT=8080
# STATIC_DIR=apps/dashboard/dist
# BOOTSTRAP_ADMIN_EMAIL=admin@urumi.local
# BOOTSTRAP_ADMIN_PASSWORD=adminpassword
